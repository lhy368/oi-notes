---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';

const posts = (await getCollection('posts', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);

// 按年份分组
const byYear = new Map<number, typeof posts>();
for (const post of posts) {
  const y = post.data.date.getFullYear();
  if (!byYear.has(y)) byYear.set(y, []);
  byYear.get(y)!.push(post);
}
const years = [...byYear.keys()].sort((a, b) => b - a);

const fmt = new Intl.DateTimeFormat('zh-CN', {
  month: '2-digit',
  day: '2-digit',
});
---

<Base>
  <section class="intro">
    <h1>OI Notes</h1>
    <p>
      算法竞赛题解、比赛复盘与专题总结 —— 共 <strong>{posts.length}</strong> 篇
    </p>
  </section>

  {
    years.map((y) => (
      <section class="year-group">
        <h2 class="year">{y}</h2>
        <ul class="post-list">
          {byYear.get(y)!.map((post) => (
            <li>
              <a href={`/posts/${post.id}/`}>
                <time datetime={post.data.date.toISOString()}>{fmt.format(post.data.date)}</time>
                <span class="post-title">{post.data.title}</span>
                <span class="post-tags">
                  {post.data.tags.slice(0, 3).map((t) => (
                    <span class="tag">{t}</span>
                  ))}
                </span>
              </a>
            </li>
          ))}
        </ul>
      </section>
    ))
  }

  {
    posts.length === 0 && (
      <p style="color: var(--fg-muted)">
        还没有文章。运行 <code>npm run import &lt;文件路径&gt;</code> 从训练目录导入。
      </p>
    )
  }
</Base>
