# 复制这个文件为 .env，填入你的博客园信息。
# .env 已被 .gitignore 忽略，不会被提交到 Git。
#
# 获取方式：
#   1. 登录博客园 → https://i.cnblogs.com/settings
#   2. 找到「其他设置」→ 勾选「允许博客客户端访问（MetaWeblog）」→ 保存
#   3. 复制显示出来的「访问令牌」

# 博客名：博客地址里那一段，例如 cnblogs.com/lhy368 就填 lhy368
CNBLOGS_BLOG=

# 登录名（不是昵称）
CNBLOGS_USER=

# 访问令牌（等同密码，务必保密）
CNBLOGS_TOKEN=
